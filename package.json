{
  "name": "react-pgn-viewer",
  "version": "2.0.1",
  "description": "React component for creating an interactive PGN viewer from string",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run tsup",
    "preview": "bun run --bun vite preview",
    "test": "bun run vitest",
    "test:run": "bun run vitest run",
    "test:coverage": "bun run vitest run --coverage",
    "lint": "bun eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "bun eslint . --ext ts,tsx --fix",
    "typecheck": "bun tsc --noEmit",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "clean": "bun rm -rf dist node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajGingrich/react-pgn-viewer.git"
  },
  "author": {
    "name": "Andrew Gingrich",
    "email": "ajgingrich@yahoo.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ajGingrich/react-pgn-viewer/issues"
  },
  "homepage": "https://github.com/ajGingrich/react-pgn-viewer#readme",
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "react-chessboard": "^4.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "typescript-plugin-css-modules": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
