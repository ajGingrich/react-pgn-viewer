  "description": "React component for creating an interactive PGN viewer",
  "type": "module",
  "main": "./dist/react-pgn-viewer.umd.js",
  "module": "./dist/react-pgn-viewer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-pgn-viewer.es.js",
      "require": "./dist/react-pgn-viewer.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
